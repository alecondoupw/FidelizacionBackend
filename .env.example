# Copiar a .env (ignorado por Git). Sólo nombres y valores locales de ejemplo; nunca credenciales reales.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Orígenes del frontend autorizados por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin SDK. Vacías hasta DEC-02 y autorización de Paulo.
# GOOGLE_APPLICATION_CREDENTIALS apunta a un archivo fuera del repositorio; el SDK la lee directamente.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Fuente del vínculo (DEC-17): clientes importados por marca.
# importacion (por defecto) o sintetica (añade el doble de desarrollo ejemplo.test).
LEGACY_SOURCE=sintetica
# Prefijo de colecciones Firestore; vacío en desarrollo normal.
FIRESTORE_PREFIX=

# Claves de la API de integración (DEC-05): «sistema:sha256» separadas por coma.
# Se generan con: npm run integracion:clave -- --sistema <nombre>
INTEGRACION_CLAVES=

# Operación (F7). Detrás del balanceador de Render: TRUST_PROXY=1.
TRUST_PROXY=0
# Peticiones por minuto e IP a la API.
LIMITE_POR_MINUTO=300
